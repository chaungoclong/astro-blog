---
import '../styles/global.css';
import { settingService, statsService } from '../api';

interface Props {
  title?: string;
  activeNav?:
    | 'dashboard'
    | 'posts'
    | 'new-post'
    | 'pages'
    | 'new-page'
    | 'media'
    | 'categories'
    | 'menus'
    | 'users'
    | 'roles'
    | 'permissions'
    | 'settings';
}

const { title = 'Quản trị hệ thống', activeNav = 'dashboard' } = Astro.props;
const settings = await settingService.getSettings();
const siteTitle = settings.site_title || 'Astro TechLog';
const stats = await statsService.getStats();
const navGroups: Record<string, string> = {
  dashboard: 'Tổng quan',
  posts: 'Nội dung',
  'new-post': 'Nội dung',
  pages: 'Nội dung',
  'new-page': 'Nội dung',
  media: 'Nội dung',
  categories: 'Cấu trúc',
  menus: 'Cấu trúc',
  users: 'Phân quyền',
  roles: 'Phân quyền',
  permissions: 'Phân quyền',
  settings: 'Hệ thống',
};
const navGroup = navGroups[activeNav] || 'Quản trị';
---

<!doctype html>
<html lang="vi" class="h-full bg-slate-900 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Admin Console - {siteTitle}</title>
  </head>
  <body
    class="admin-theme h-full flex overflow-hidden bg-slate-50 text-slate-800 antialiased"
    data-forbidden={Astro.url.searchParams.has('forbidden') ? 'true' : 'false'}
  >
    <!-- Sidebar for Desktop (Material Minimal Drawer) -->
    <aside class="w-72 bg-slate-900 text-slate-300 flex flex-col flex-shrink-0 h-screen border-r border-slate-800 select-none hidden md:flex z-40">
      <!-- Brand & Project Header -->
      <div class="h-16 flex items-center justify-between px-5 border-b border-slate-800 bg-slate-900">
        <a href="/admin" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-blue-600 text-white font-bold text-xs flex items-center justify-center shadow-xs group-hover:bg-blue-500 transition-colors">
            TC
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <span class="font-bold text-white text-sm tracking-tight">TechCMS</span>
              <span class="px-1.5 py-0.5 rounded bg-slate-800 text-[10px] font-mono text-slate-400">
                v5
              </span>
            </div>
            <span class="text-[11px] text-slate-400 font-medium block truncate max-w-[130px]">
              {siteTitle}
            </span>
          </div>
        </a>

        <!-- Live DB Status Pill -->
        <div
          class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[10px] font-mono text-emerald-400 font-medium"
          title="Cơ sở dữ liệu SQLite hoạt động bình thường"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>SQL</span>
        </div>
      </div>

      <!-- Navigation Menu -->
      <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto text-xs font-medium">
        <div class="px-3 pt-2 pb-1 text-[11px] uppercase font-semibold text-slate-400 tracking-wider">
          Tổng quan
        </div>

        <a
          href="/admin"
          class={`flex items-center justify-between px-3 py-2 rounded-lg transition-colors ${activeNav === 'dashboard' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
              ></path>
            </svg>
            <span>Tổng quan</span>
          </div>
          <span
            class={`text-[10px] font-mono ${activeNav === 'dashboard' ? 'text-white/80' : 'text-slate-500'}`}
          >
            D1
          </span>
        </a>

        <div class="px-3 pt-5 pb-1 text-[11px] uppercase font-semibold text-slate-400 tracking-wider">
          Nội dung
        </div>

        <a
          href="/admin/posts"
          class={`flex items-center justify-between px-3 py-2 rounded-lg transition-colors ${activeNav === 'posts' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
              ></path>
            </svg>
            <span>Tất cả bài viết</span>
          </div>
          <span
            class={`px-1.5 py-0.2 rounded-full text-[10px] font-mono font-medium ${activeNav === 'posts' ? 'bg-white/20 text-white' : 'bg-slate-800 text-slate-300'}`}
          >
            {stats.totalPosts}
          </span>
        </a>

        <a
          href="/admin/posts/new"
          class={`flex items-center justify-between px-3 py-2 rounded-lg transition-colors ${activeNav === 'new-post' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'border border-dashed border-slate-700/80 text-slate-300 hover:text-white hover:bg-slate-800/70 hover:border-slate-600'}`}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              ></path>
            </svg>
            <span>Soạn bài mới</span>
          </div>
          <span
            class={`text-[10px] font-mono font-medium ${activeNav === 'new-post' ? 'text-white/80' : 'text-slate-400'}`}
          >
            +New
          </span>
        </a>

        <div class="px-3 pt-5 pb-1 text-[11px] uppercase font-semibold text-slate-400 tracking-wider">
          Cấu trúc
        </div>

        <a
          href="/admin/categories"
          class={`flex items-center justify-between px-3 py-2 rounded-lg transition-colors ${activeNav === 'categories' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
              ></path>
            </svg>
            <span>Chuyên mục</span>
          </div>
          <span
            class={`px-1.5 py-0.2 rounded-full text-[10px] font-mono font-medium ${activeNav === 'categories' ? 'bg-white/20 text-white' : 'bg-slate-800 text-slate-300'}`}
          >
            {stats.totalCategories}
          </span>
        </a>

        <a
          href="/admin/pages"
          class={`flex items-center justify-between px-3 py-2 rounded-lg transition-colors ${activeNav === 'pages' || activeNav === 'new-page' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M7 3h7l3 3v15H7zM14 3v4h4M10 12h4M10 16h4"
              />
            </svg>
            <span>Trang tĩnh</span>
          </div>
          <span
            class={`px-1.5 py-0.2 rounded-full text-[10px] font-mono font-medium ${activeNav === 'pages' || activeNav === 'new-page' ? 'bg-white/20 text-white' : 'bg-slate-800 text-slate-300'}`}
          >
            {stats.totalPages}
          </span>
        </a>

        <a
          href="/admin/media"
          class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${activeNav === 'media' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4-4 3 3 5-6 4 5v4H4zM4 4h16v16H4z"
            />
          </svg>
          <span>Media Library</span>
        </a>

        <a
          href="/admin/menus"
          class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${activeNav === 'menus' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <svg class="h-4 w-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h10M4 18h16" />
          </svg>
          <span>Menu website</span>
        </a>

        <div class="px-3 pt-5 pb-1 text-[11px] uppercase font-semibold text-slate-400 tracking-wider">
          Phân quyền
        </div>

        <a
          href="/admin/users"
          class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${activeNav === 'users' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <svg class="h-4 w-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
            />
          </svg>
          <span>Người dùng</span>
        </a>

        <a
          href="/admin/roles"
          class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${activeNav === 'roles' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <svg class="h-4 w-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
            />
          </svg>
          <span>Vai trò</span>
        </a>

        <a
          href="/admin/permissions"
          class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-colors ${activeNav === 'permissions' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <svg class="h-4 w-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"
            />
          </svg>
          <span>Permissions</span>
        </a>

        <div class="px-3 pt-5 pb-1 text-[11px] uppercase font-semibold text-slate-400 tracking-wider">
          Hệ thống
        </div>

        <a
          href="/admin/settings"
          class={`flex items-center justify-between px-3 py-2 rounded-lg transition-colors ${activeNav === 'settings' ? 'bg-blue-600 text-white font-semibold shadow-xs' : 'text-slate-300 hover:text-white hover:bg-slate-800/70'}`}
        >
          <div class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-current" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
            <span>Cài đặt hệ thống</span>
          </div>
        </a>

        <div class="px-3 pt-5 pb-1 text-[11px] uppercase font-semibold text-slate-400 tracking-wider">
          Liên kết ngoài
        </div>

        <a
          href="/"
          target="_blank"
          class="flex items-center justify-between px-3 py-2 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800/70 transition-colors"
        >
          <div class="flex items-center gap-2.5">
            <svg
              class="w-4 h-4 text-slate-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
            <span>Xem Blog</span>
          </div>
          <span class="text-[10px] font-mono text-slate-500">↗</span>
        </a>
      </nav>

      <!-- User Profile in Sidebar Footer -->
      <div class="p-3 border-t border-slate-800 bg-slate-900">
        <div class="flex items-center justify-between p-2.5 rounded-lg bg-slate-800/60 border border-slate-800">
          <div class="flex items-center gap-2.5 overflow-hidden">
            <div class="w-8 h-8 rounded-full bg-slate-700 text-white font-bold text-xs flex items-center justify-center flex-shrink-0">
              AD
            </div>
            <div class="overflow-hidden">
              <span class="text-xs font-semibold text-white block truncate">
                {settings.admin_username || 'admin'}
              </span>
              <span class="text-[10px] text-slate-400 block truncate font-mono">Super Admin</span>
            </div>
          </div>

          <a
            href="/api/auth/logout"
            title="Đăng xuất tài khoản"
            class="p-1.5 rounded-md text-slate-400 hover:text-red-400 hover:bg-slate-700/60 transition-colors cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content Container with Independent Scroll -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden min-w-0">
      <!-- Top Header Bar (Material Elevation) -->
      <header class="h-16 bg-white border-b border-slate-200/80 px-5 sm:px-8 flex items-center justify-between flex-shrink-0 z-30 shadow-2xs">
        <div class="flex items-center gap-3">
          <!-- Mobile Menu Toggle Button -->
          <button
            id="mobile-menu-btn"
            type="button"
            class="md:hidden p-2 rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 cursor-pointer"
            aria-label="Mở menu điều hướng"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
              ></path>
            </svg>
          </button>

          <!-- Breadcrumb navigation -->
          <nav
            aria-label="Breadcrumb"
            class="flex items-center gap-2 overflow-x-auto whitespace-nowrap text-xs font-medium text-slate-500"
          >
            <a href="/admin" class="hover:text-blue-600 transition-colors">
              Admin
            </a>
            <span aria-hidden="true" class="text-slate-300">
              /
            </span>
            <span>{navGroup}</span>
            <span aria-hidden="true" class="text-slate-300">
              /
            </span>
            <h1 class="font-bold text-slate-900 text-sm">{title}</h1>
          </nav>
        </div>

        <!-- Top Right Actions -->
        <div class="flex items-center gap-2.5">
          <a
            href="/"
            target="_blank"
            class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 hover:border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-medium transition-colors"
          >
            <svg
              class="w-3.5 h-3.5 text-slate-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              ></path>
            </svg>
            <span>Xem Blog</span>
          </a>

          <a
            href="/admin/posts/new"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow-xs text-xs font-semibold transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 4v16m8-8H4"
              ></path>
            </svg>
            <span>+ Viết bài mới</span>
          </a>

          <a
            href="/api/auth/logout"
            class="p-2 rounded-lg border border-slate-200 hover:bg-red-50 hover:border-red-200 hover:text-red-600 text-slate-500 text-xs font-medium transition-colors cursor-pointer"
            title="Đăng xuất"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
              ></path>
            </svg>
          </a>
        </div>
      </header>

      <!-- Scrollable Main Content Area -->
      <main class="flex-1 overflow-y-auto p-5 sm:p-8 bg-slate-50/70">
        <div class="mx-auto w-full max-w-[100rem] space-y-6">
          <slot />
        </div>
      </main>
    </div>

    <!-- Mobile Drawer -->
    <div
      id="mobile-drawer"
      class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-xs hidden md:hidden"
    >
      <div class="w-72 bg-slate-900 text-slate-300 h-full flex flex-col p-4 border-r border-slate-800 shadow-2xl">
        <div class="flex items-center justify-between pb-4 border-b border-slate-800">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-blue-600 text-white text-[10px] font-bold flex items-center justify-center shadow-xs">
              TC
            </div>
            <span class="font-bold text-white text-sm">TechCMS</span>
          </div>
          <button
            id="close-drawer-btn"
            class="p-1.5 rounded-md text-slate-400 hover:text-white hover:bg-slate-800"
            aria-label="Đóng menu"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
              ></path>
            </svg>
          </button>
        </div>

        <nav class="space-y-1 text-xs font-medium py-4 flex-1 overflow-y-auto">
          <a
            href="/admin"
            class={`block px-3 py-2 rounded-lg ${activeNav === 'dashboard' ? 'bg-blue-600 text-white font-semibold' : 'text-slate-300 hover:bg-slate-800'}`}
          >
            Tổng quan
          </a>
          <a
            href="/admin/posts"
            class={`block px-3 py-2 rounded-lg ${activeNav === 'posts' ? 'bg-blue-600 text-white font-semibold' : 'text-slate-300 hover:bg-slate-800'}`}
          >
            Tất cả bài viết
          </a>
          <a
