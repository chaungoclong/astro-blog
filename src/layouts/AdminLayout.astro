    <!-- Material Toast Region -->
    <div
      id="admin-toast-region"
      class="pointer-events-none fixed right-4 top-4 z-[100] flex w-[min(24rem,calc(100vw-2rem))] flex-col gap-2"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <script>
      const TOAST_DURATION_MS = 4200;
      const ADMIN_FLASH_KEY = 'admin-flash-message';
      const TOAST_STYLES = {
        success: 'border border-emerald-200 bg-emerald-50/95 text-emerald-950 shadow-md',
        error: 'border border-red-200 bg-red-50/95 text-red-950 shadow-md',
        info: 'border border-blue-200 bg-blue-50/95 text-blue-950 shadow-md',
      };
      (window as any).showAdminToast = (
        message: string,
        type: 'success' | 'error' | 'info' = 'info'
      ) => {
        const region = document.getElementById('admin-toast-region');
        if (!region) return;
        const toast = document.createElement('div');
        toast.className =
          'pointer-events-auto flex items-start gap-3 p-3.5 text-xs font-medium rounded-xl transition-all duration-200 ' +
          (TOAST_STYLES[type] || TOAST_STYLES.info);
        const text = document.createElement('span');
        const close = document.createElement('button');
        text.className = 'flex-1 leading-relaxed';
        text.textContent = message;
        close.type = 'button';
        close.className =
          'p-0.5 rounded text-current opacity-60 hover:opacity-100 hover:bg-black/5 cursor-pointer';
        close.textContent = '✕';
        close.setAttribute('aria-label', 'Đóng thông báo');
        close.addEventListener('click', () => toast.remove());
        toast.append(text, close);
        region.appendChild(toast);
        window.setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(-4px)';
          setTimeout(() => toast.remove(), 200);
        }, TOAST_DURATION_MS);
      };
      (window as any).setAdminFlash = (
        message: string,
        type: 'success' | 'error' | 'info' = 'info'
      ) => {
        window.sessionStorage.setItem(ADMIN_FLASH_KEY, JSON.stringify({ message, type }));
      };

      const pendingFlash = window.sessionStorage.getItem(ADMIN_FLASH_KEY);
      if (pendingFlash) {
        window.sessionStorage.removeItem(ADMIN_FLASH_KEY);
        try {
          const flash = JSON.parse(pendingFlash);
          (window as any).showAdminToast(flash.message, flash.type);
        } catch {
          // Ignore malformed client-only flash data.
        }
      }
      if (document.body.dataset.forbidden === 'true') {
        (window as any).showAdminToast('Bạn không có permission để mở khu vực đó.', 'error');
        window.history.replaceState({}, '', '/admin');
      }

      const mobileBtn = document.getElementById('mobile-menu-btn');
      const drawer = document.getElementById('mobile-drawer');
      const closeBtn = document.getElementById('close-drawer-btn');

      mobileBtn?.addEventListener('click', () => {
        drawer?.classList.remove('hidden');
      });

      closeBtn?.addEventListener('click', () => {
        drawer?.classList.add('hidden');
      });

      drawer?.addEventListener('click', (e) => {
        if (e.target === drawer) {
          drawer.classList.add('hidden');
        }
      });
    </script>
  </body>
</html>
