---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { dbService } from '../../lib/db';

const { slug } = Astro.params;
const category = dbService.getCategoryBySlug(slug as string);

if (!category) {
  // Try by name directly if slug isn't matching
  const allCats = dbService.getCategories();
  const found = allCats.find((c) => c.slug === slug || c.name === slug);
  if (!found) {
    return Astro.redirect('/');
  }
}

const catName = category?.name || (slug as string);
const posts = dbService.getPosts({ status: 'published', category: catName, limit: 50 });
---

<BaseLayout title={`Chuyên mục: ${catName}`}>
  
  <div class="border-b-2 border-zinc-950 bg-[var(--retro-paper)] py-10 sm:py-14">
    <div class="public-content-rail">
      <div class="max-w-3xl">
        <Breadcrumbs items={[{ label: 'Trang chủ', href: '/' }, { label: 'Chuyên mục' }, { label: catName }]} />
        <p class="font-mono text-xs font-bold text-[var(--brand-deep,#115e59)] uppercase tracking-widest mt-4 mb-1">Chuyên mục bài viết</p>
        <h1 class="text-3xl sm:text-5xl font-bold text-zinc-950 tracking-tight" style="font-family: var(--font-display);">
          {catName}
        </h1>
        {category?.description && (
          <p class="text-sm sm:text-base text-zinc-600 mt-2.5 leading-relaxed">
            {category.description}
          </p>
        )}
        <div class="mt-4 font-mono text-xs text-zinc-600">
          Tổng cộng <span class="font-bold text-zinc-950 px-1.5 py-0.5 border border-zinc-950 bg-[var(--retro-yellow)]">{posts.length}</span> bài viết đã xuất bản
        </div>
      </div>
    </div>
  </div>

  <div class="public-content-rail py-10 sm:py-14">
    {posts.length === 0 ? (
      <div class="border-2 border-zinc-950 bg-white p-12 text-center shadow-[4px_4px_0_var(--retro-ink)]">
        <p class="text-zinc-900 font-bold text-base" style="font-family: var(--font-display);">Chưa có bài viết nào trong chuyên mục này.</p>
        <a href="/" class="text-xs font-mono font-bold text-[var(--brand-deep,#115e59)] hover:underline mt-2 inline-block">← Khám phá các bài viết khác trên trang chủ</a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </div>

</BaseLayout>
