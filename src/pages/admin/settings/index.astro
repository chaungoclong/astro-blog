---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { settingService } from '../../../api';

const settings = await settingService.getSettings();
---

<AdminLayout title="Cài đặt hệ thống" activeNav="settings">
  <div class="max-w-4xl space-y-8">
    <!-- General Settings Card -->
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-6 sm:p-7 space-y-6">
      <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-slate-900 tracking-tight">Cấu hình thông tin Blog</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Tiêu đề, khẩu hiệu và thông tin hiển thị của trang web
          </p>
        </div>
        <span class="text-[11px] font-mono font-medium text-slate-400 px-2 py-0.5 rounded bg-slate-100">
          CONFIG
        </span>
      </div>

      <form id="general-settings-form" class="space-y-5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="site_title" class="block text-xs font-semibold text-slate-700 mb-1.5">
              Tên Blog / Website <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="site_title"
              name="site_title"
              required
              value={settings.site_title || 'Astro TechLog'}
              class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
            />
          </div>

          <div>
            <label for="author_name" class="block text-xs font-semibold text-slate-700 mb-1.5">
              Tác giả mặc định <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="author_name"
              name="author_name"
              required
              value={settings.author_name || 'Châu Ngọc Long'}
              class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
            />
          </div>
        </div>

        <div>
          <label for="site_subtitle" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Khẩu hiệu (Tagline / Phụ đề)
          </label>
          <input
            type="text"
            id="site_subtitle"
            name="site_subtitle"
            value={settings.site_subtitle || ''}
            class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          />
        </div>

        <div>
          <label for="site_description" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Mô tả tóm lược Blog (SEO Meta Description)
          </label>
          <textarea
            id="site_description"
            name="site_description"
            rows="3"
            class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-medium text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          >{settings.site_description || ''}</textarea>
        </div>

        <div>
          <label for="posts_per_page" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Số bài viết mỗi trang (Phân trang)
          </label>
          <input
            type="number"
            id="posts_per_page"
            name="posts_per_page"
            min="1"
            max="30"
            value={settings.posts_per_page || '6'}
            class="w-32 px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-mono font-medium text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          />
        </div>

        <fieldset class="pt-5 border-t border-slate-100">
          <legend class="text-xs font-bold uppercase tracking-wider text-slate-800">
            Bảng màu nhận diện thương hiệu
          </legend>
          <p class="text-xs text-slate-500 mt-1 mb-4">
            Các biến màu áp dụng cho các điểm nhấn của blog công khai.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <label class="block text-xs font-semibold text-slate-700">
              Brand chính
              <span class="mt-1.5 flex items-center gap-2">
                <input
                  type="color"
                  value={settings.brand_color || '#0f766e'}
                  class="h-9 w-11 cursor-pointer rounded-lg border border-slate-200 p-0.5 bg-white"
                  data-color-picker="brand_color"
                />
                <input
                  type="text"
                  name="brand_color"
                  value={settings.brand_color || '#0f766e'}
                  pattern="^#[0-9a-fA-F]{6}$"
                  required
                  class="w-full px-3 py-2 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-mono text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
                />
              </span>
            </label>
            <label class="block text-xs font-semibold text-slate-700">
              Brand đậm
              <span class="mt-1.5 flex items-center gap-2">
                <input
                  type="color"
                  value={settings.brand_color_deep || '#115e59'}
                  class="h-9 w-11 cursor-pointer rounded-lg border border-slate-200 p-0.5 bg-white"
                  data-color-picker="brand_color_deep"
                />
                <input
                  type="text"
                  name="brand_color_deep"
                  value={settings.brand_color_deep || '#115e59'}
                  pattern="^#[0-9a-fA-F]{6}$"
                  required
                  class="w-full px-3 py-2 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-mono text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
                />
              </span>
            </label>
            <label class="block text-xs font-semibold text-slate-700">
              Nền trang
              <span class="mt-1.5 flex items-center gap-2">
                <input
                  type="color"
                  value={settings.surface_color || '#f8fafc'}
                  class="h-9 w-11 cursor-pointer rounded-lg border border-slate-200 p-0.5 bg-white"
                  data-color-picker="surface_color"
                />
                <input
                  type="text"
                  name="surface_color"
                  value={settings.surface_color || '#f8fafc'}
                  pattern="^#[0-9a-fA-F]{6}$"
                  required
                  class="w-full px-3 py-2 bg-slate-50/70 border border-slate-200 rounded-lg text-xs font-mono text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
                />
              </span>
            </label>
          </div>
        </fieldset>

        <div class="pt-2">
          <button
            type="submit"
            id="save-general-btn"
            class="px-5 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs rounded-lg shadow-xs transition-colors cursor-pointer"
          >
            Lưu cài đặt chung
          </button>
        </div>
      </form>
    </div>

    <!-- Security & Password Card -->
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs p-6 sm:p-7 space-y-6">
      <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-slate-900 tracking-tight">Bảo mật & Đổi mật khẩu</h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Tài khoản quản trị viên:{' '}
            <strong class="text-slate-800 font-medium">{settings.admin_username || 'admin'}</strong>
          </p>
        </div>
        <span class="text-[11px] font-mono font-medium text-slate-400 px-2 py-0.5 rounded bg-slate-100">
          AUTH
        </span>
      </div>

      <form id="password-form" class="space-y-4 max-w-md">
        <div>
          <label for="current_password" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Mật khẩu hiện tại <span class="text-red-500">*</span>
          </label>
          <input
            type="password"
            id="current_password"
            name="current_password"
            required
            class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all font-mono"
            placeholder="Mật khẩu hiện tại"
          />
        </div>

        <div>
          <label for="new_password" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Mật khẩu mới <span class="text-red-500">*</span>
          </label>
          <input
            type="password"
            id="new_password"
            name="new_password"
            required
            minlength="6"
            class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all font-mono"
            placeholder="Tối thiểu 6 ký tự"
          />
        </div>

        <div>
          <label for="confirm_password" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Xác nhận mật khẩu mới <span class="text-red-500">*</span>
          </label>
          <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            required
            minlength="6"
            class="w-full px-3.5 py-2.5 bg-slate-50/70 border border-slate-200 rounded-lg text-xs text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all font-mono"
          />
        </div>

        <div class="pt-2">
          <button
            type="submit"
            id="save-password-btn"
            class="px-5 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-xs rounded-lg shadow-xs transition-colors cursor-pointer"
          >
            Đổi mật khẩu
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const generalForm = document.getElementById('general-settings-form') as HTMLFormElement;
    const saveGeneralBtn = document.getElementById('save-general-btn') as HTMLButtonElement;
    const passwordForm = document.getElementById('password-form') as HTMLFormElement;
    const savePasswordBtn = document.getElementById('save-password-btn') as HTMLButtonElement;
    const toast = (message: string, type: 'success' | 'error' | 'info' = 'info') =>
      (window as any).showAdminToast?.(message, type);

    document.querySelectorAll('[data-color-picker]').forEach((picker) => {
      picker.addEventListener('input', () => {
        const color = picker as HTMLInputElement;
        const field = generalForm.elements.namedItem(
          color.dataset.colorPicker || ''
        ) as HTMLInputElement;
        if (field) field.value = color.value;
      });
    });

    generalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!generalForm.reportValidity()) {
        toast('Vui lòng kiểm tra các trường bắt buộc được đánh dấu *.', 'error');
        generalForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      saveGeneralBtn.disabled = true;
      saveGeneralBtn.textContent = 'Đang lưu...';

      const formData = new FormData(generalForm);
      const data = {
        site_title: formData.get('site_title'),
        author_name: formData.get('author_name'),
        site_subtitle: formData.get('site_subtitle'),
        site_description: formData.get('site_description'),
        posts_per_page: formData.get('posts_per_page'),
        brand_color: formData.get('brand_color'),
        brand_color_deep: formData.get('brand_color_deep'),
        surface_color: formData.get('surface_color'),
      };

      try {
        const res = await fetch('/api/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const resData = await res.json();
        if (res.ok && resData.success) {
          toast('Đã lưu cấu hình blog thành công.', 'success');
        } else {
          toast(resData.message || 'Lỗi khi lưu cài đặt.', 'error');
        }
      } catch {
        toast('Lỗi kết nối khi lưu cài đặt.', 'error');
      } finally {
        saveGeneralBtn.disabled = false;
        saveGeneralBtn.textContent = 'Lưu cài đặt chung';
      }
    });

    passwordForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!passwordForm.reportValidity()) {
        toast('Vui lòng nhập đầy đủ các trường mật khẩu.', 'error');
        passwordForm.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      const formData = new FormData(passwordForm);
      const currentPassword = formData.get('current_password');
      const newPassword = formData.get('new_password');
      const confirmPassword = formData.get('confirm_password');

      if (newPassword !== confirmPassword) {
        toast('Mật khẩu mới và xác nhận mật khẩu không khớp!', 'error');
        return;
      }

      savePasswordBtn.disabled = true;
      savePasswordBtn.textContent = 'Đang xử lý...';

      try {
        const res = await fetch('/api/auth/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            currentPassword,
            newPassword,
          }),
        });

        const resData = await res.json();
        if (res.ok && resData.success) {
          toast('Đổi mật khẩu thành công.', 'success');
          passwordForm.reset();
        } else {
          toast(resData.message || 'Lỗi khi đổi mật khẩu.', 'error');
        }
      } catch {
        toast('Lỗi kết nối khi đổi mật khẩu.', 'error');
      } finally {
        savePasswordBtn.disabled = false;
        savePasswordBtn.textContent = 'Đổi mật khẩu';
      }
    });
  </script>
</AdminLayout>
