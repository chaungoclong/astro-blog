---
import '../../styles/global.css';
import { isAuthenticated } from '../../lib/auth';
import { dbService } from '../../lib/db';

// If already logged in, redirect to admin
if (isAuthenticated(Astro.cookies)) {
  return Astro.redirect('/admin');
}

const settings = dbService.getSettings();
---

<!doctype html>
<html lang="vi" class="h-full bg-zinc-950 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Đăng nhập Quản trị | {settings.site_title}</title>
  </head>
  <body class="h-full flex items-center justify-center p-4 selection:bg-blue-600 selection:text-white">
    
    <div class="w-full max-w-sm">
      
      <!-- Brand & Header -->
      <div class="text-center mb-6">
        <div class="inline-flex w-12 h-12 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 items-center justify-center text-white shadow-lg shadow-blue-500/20 mb-3 text-lg font-black">
          ⚡
        </div>
        <h1 class="text-xl font-black text-white tracking-tight">Đăng Nhập Quản Trị</h1>
        <p class="text-xs text-zinc-400 mt-1">{settings.site_title || 'Astro TechLog'} CMS</p>
      </div>

      <!-- Card Container -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-6 shadow-2xl backdrop-blur-md">
        
        <!-- Error Message Alert -->
        <div id="error-alert" class="hidden mb-4 p-3 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-xs flex items-center gap-2">
          <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span id="error-text">Đăng nhập thất bại.</span>
        </div>

        <form id="login-form" class="space-y-4">
          <div>
            <label for="username" class="block text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-1.5">
              Tài khoản
            </label>
            <input 
              type="text" 
              id="username" 
              name="username" 
              required 
              value="admin"
              autocomplete="username"
              class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-800 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 text-xs font-mono transition-colors"
              placeholder="Nhập tên tài khoản"
            />
          </div>

          <div>
            <label for="password" class="block text-[11px] font-bold uppercase tracking-wider text-zinc-400 mb-1.5">
              Mật khẩu
            </label>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              value="admin123"
              autocomplete="current-password"
              class="w-full px-3 py-2.5 bg-zinc-950 border border-zinc-800 rounded-lg text-white placeholder-zinc-500 focus:outline-none focus:border-blue-500 text-xs font-mono transition-colors"
              placeholder="Nhập mật khẩu"
            />
          </div>

          <button 
            type="submit" 
            id="submit-btn"
            class="w-full py-2.5 px-4 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-lg text-xs shadow-sm transition-all duration-200 active:scale-[0.98] flex items-center justify-center gap-2 cursor-pointer mt-2"
          >
            <span id="btn-text">Đăng nhập Bảng Điều Khiển</span>
            <svg id="btn-spinner" class="animate-spin -ml-1 mr-2 h-4 w-4 text-white hidden" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>

        <!-- Default Credentials Hint -->
        <div class="mt-5 pt-4 border-t border-zinc-800 text-[11px] text-zinc-400">
          <div class="flex items-center gap-1.5 font-semibold text-zinc-300 mb-1.5">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Tài khoản thử nghiệm:</span>
          </div>
          <div class="bg-zinc-950 p-2 rounded-lg font-mono text-zinc-400 flex justify-between items-center text-[11px] border border-zinc-800">
            <span>User: <strong class="text-blue-400">admin</strong></span>
            <span>Pass: <strong class="text-blue-400">admin123</strong></span>
          </div>
        </div>

      </div>

      <!-- Back to site link -->
      <div class="text-center mt-5">
        <a href="/" class="text-xs text-zinc-500 hover:text-zinc-300 transition-colors inline-flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
          <span>Quay lại trang Blog</span>
        </a>
      </div>

    </div>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorAlert = document.getElementById('error-alert') as HTMLDivElement;
      const errorText = document.getElementById('error-text') as HTMLSpanElement;
      const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
      const btnText = document.getElementById('btn-text') as HTMLSpanElement;
      const btnSpinner = document.getElementById('btn-spinner') as HTMLElement;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorAlert?.classList.add('hidden');
        submitBtn.disabled = true;
        btnText.textContent = 'Đang xác thực...';
        btnSpinner.classList.remove('hidden');

        const formData = new FormData(form);
        const username = formData.get('username');
        const password = formData.get('password');

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username, password }),
          });

          const data = await res.json();
          if (res.ok && data.success) {
            const urlParams = new URLSearchParams(window.location.search);
            const redirect = urlParams.get('redirect') || '/admin';
            window.location.href = redirect;
          } else {
            errorText.textContent = data.message || 'Tài khoản hoặc mật khẩu không chính xác.';
            errorAlert.classList.remove('hidden');
            submitBtn.disabled = false;
            btnText.textContent = 'Đăng nhập Bảng Điều Khiển';
            btnSpinner.classList.add('hidden');
          }
        } catch {
          errorText.textContent = 'Lỗi kết nối máy chủ.';
          errorAlert.classList.remove('hidden');
          submitBtn.disabled = false;
          btnText.textContent = 'Đăng nhập Bảng Điều Khiển';
          btnSpinner.classList.add('hidden');
        }
      });
    </script>

  </body>
</html>
