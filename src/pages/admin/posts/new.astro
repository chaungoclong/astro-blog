---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { dbService } from '../../../lib/db';
import MediaPicker from '../../../components/MediaPicker.astro';

const categories = dbService.getCategories();
const settings = dbService.getSettings();
---

<AdminLayout title="Tạo bài viết mới" activeNav="new-post">
  
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-2 border-b border-slate-200/60">
    <div>
      <h2 class="text-base font-bold text-slate-900 tracking-tight">Soạn thảo bài viết mới</h2>
      <p class="text-xs text-slate-500 mt-0.5">Hỗ trợ Markdown tiêu chuẩn, khối mã và ảnh bìa</p>
    </div>

    <div class="admin-sticky-actions flex items-center gap-2">
      <a 
        href="/admin/posts" 
        class="px-3.5 py-1.5 border border-slate-200 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-medium transition-colors"
      >
        Hủy
      </a>
      <button 
        type="button" 
        id="save-post-btn"
        class="px-4 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path>
        </svg>
        <span id="save-btn-text">Lưu bài viết</span>
      </button>
    </div>
  </div>

  <form id="post-form" class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <!-- Left Column: Main Editor (2 cols) -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Title & Excerpt Card -->
      <div class="bg-white rounded-xl p-5 sm:p-6 border border-slate-200/80 shadow-xs space-y-4">
        <div>
          <label for="title" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Tiêu đề bài viết <span class="text-red-500">*</span>
          </label>
          <input 
            type="text" 
            id="title" 
            name="title" 
            required 
            placeholder="Nhập tiêu đề bài viết công nghệ..." 
            class="w-full px-3.5 py-2.5 bg-slate-50/60 border border-slate-200 rounded-lg text-sm font-semibold text-slate-900 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <label for="slug" class="block text-xs font-semibold text-slate-600">
              Đường dẫn tĩnh (Slug URL)
            </label>
            <span class="text-[11px] text-slate-400">Tự động sinh từ tiêu đề</span>
          </div>
          <div class="flex items-center">
            <span class="px-3 py-2 bg-slate-100 border border-r-0 border-slate-200 rounded-l-lg text-xs text-slate-500 font-mono">
              /blog/
            </span>
            <input 
              type="text" 
              id="slug" 
              name="slug" 
              placeholder="duong-dan-bai-viet" 
              class="w-full px-3 py-2 bg-slate-50/60 border border-slate-200 rounded-r-lg text-xs font-mono text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
            />
          </div>
        </div>

        <div>
          <label for="excerpt" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Tóm tắt ngắn (Excerpt)
          </label>
          <textarea 
            id="excerpt" 
            name="excerpt" 
            rows="2" 
            placeholder="Mô tả tóm tắt nội dung bài viết..." 
            class="w-full px-3.5 py-2 bg-slate-50/60 border border-slate-200 rounded-lg text-xs text-slate-700 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          ></textarea>
        </div>
      </div>

      <!-- Markdown Content Editor Card -->
      <div class="bg-white rounded-xl border border-slate-200/80 shadow-xs overflow-hidden flex flex-col">
        
        <!-- Editor Header & Toolbar -->
        <div class="px-4 py-2.5 bg-slate-50/80 border-b border-slate-200/80 flex flex-wrap items-center justify-between gap-2">
          
          <!-- Mode Tabs -->
          <div class="flex items-center bg-slate-200/70 p-0.5 rounded-lg text-xs font-semibold">
            <button 
              type="button" 
              id="tab-edit" 
              class="px-3 py-1 rounded-md bg-white text-slate-900 shadow-2xs cursor-pointer transition-all"
            >
              Soạn thảo
            </button>
            <button 
              type="button" 
              id="tab-preview" 
              class="px-3 py-1 rounded-md text-slate-600 hover:text-slate-900 cursor-pointer transition-all"
            >
              Xem trước
            </button>
          </div>

          <!-- Markdown quick buttons -->
          <div id="toolbar-actions" class="flex items-center gap-1">
            <button type="button" data-syntax="**" class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs font-bold cursor-pointer transition-colors" title="In đậm">B</button>
            <button type="button" data-syntax="*" class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs italic font-serif cursor-pointer transition-colors" title="In nghiêng">I</button>
            <button type="button" data-prefix="## " class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs font-semibold cursor-pointer transition-colors" title="Tiêu đề H2">H2</button>
            <button type="button" data-prefix="### " class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs font-semibold cursor-pointer transition-colors" title="Tiêu đề H3">H3</button>
            <button type="button" data-prefix="> " class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs cursor-pointer transition-colors" title="Trích dẫn">Quote</button>
            <button type="button" data-wrap="```\n" data-wrap-end="\n```" class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs font-mono cursor-pointer transition-colors" title="Khối mã">{"{ code }"}</button>
            <button type="button" data-syntax="link" class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs cursor-pointer transition-colors" title="Chèn liên kết">Link</button>
            <button type="button" data-syntax="img" class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs cursor-pointer transition-colors" title="Chèn ảnh">Img</button>
            <button type="button" data-prefix="- " class="tool-btn px-2.5 py-1 text-slate-600 hover:text-blue-600 hover:bg-slate-200/70 rounded-md text-xs cursor-pointer transition-colors" title="Danh sách">• List</button>
          </div>

        </div>

        <!-- Textarea / Preview Container -->
        <div class="p-4 sm:p-5 flex-1">
          <textarea 
            id="content" 
            name="content" 
            rows="18" 
            required 
            placeholder="# Soạn nội dung bằng Markdown tại đây..." 
            class="w-full p-2 font-mono text-xs sm:text-sm text-slate-800 bg-white border-0 focus:outline-none resize-y min-h-[380px] leading-relaxed"
          ></textarea>

          <div id="preview-container" class="hidden min-h-[380px] p-6 bg-slate-50/50 prose prose-slate max-w-none border border-slate-100 rounded-lg">
          </div>
        </div>

      </div>

    </div>

    <!-- Right Column: Settings & Metadata (1 col) -->
    <div class="space-y-6">
      
      <!-- Publish Status Card -->
      <div class="bg-white rounded-xl p-5 sm:p-6 border border-slate-200/80 shadow-xs space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 border-b border-slate-100 pb-2.5">
          Thuộc tính bài viết
        </h3>

        <div>
          <label for="status" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Trạng thái
          </label>
          <select 
            id="status" 
            name="status" 
            class="w-full px-3 py-2 bg-slate-50/60 border border-slate-200 rounded-lg text-xs font-medium text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all cursor-pointer"
          >
            <option value="published">Xuất bản công khai</option>
            <option value="draft" selected>Lưu bản nháp</option>
          </select>
        </div>

        <div>
          <label for="category" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Chuyên mục
          </label>
          <select 
            id="category" 
            name="category" 
            class="w-full px-3 py-2 bg-slate-50/60 border border-slate-200 rounded-lg text-xs font-medium text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all cursor-pointer"
          >
            {categories.map((cat) => (
              <option value={cat.name}>{cat.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label for="author" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Tác giả
          </label>
          <input 
            type="text" 
            id="author" 
            name="author" 
            value={settings.author_name || 'Admin'} 
            class="w-full px-3 py-2 bg-slate-50/60 border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          />
        </div>

        <div>
          <label for="tags" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Thẻ (Tags)
          </label>
          <input 
            type="text" 
            id="tags" 
            name="tags" 
            placeholder="astro, webdev, sqlite (cách nhau dấu phẩy)" 
            class="w-full px-3 py-2 bg-slate-50/60 border border-slate-200 rounded-lg text-xs text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          />
        </div>

      </div>

      <!-- Cover Image Card -->
      <div class="bg-white rounded-xl p-5 sm:p-6 border border-slate-200/80 shadow-xs space-y-4">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 border-b border-slate-100 pb-2.5">
          Ảnh bìa bài viết
        </h3>
        <MediaPicker />

        <div>
          <label for="cover_image" class="block text-xs font-semibold text-slate-700 mb-1.5">
            Hoặc dùng URL ảnh bên ngoài
          </label>
          <input 
            type="text"
            inputmode="url"
            id="cover_image" 
            name="cover_image" 
            value="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1200&auto=format&fit=crop&q=80"
            class="w-full px-3 py-2 bg-slate-50/60 border border-slate-200 rounded-lg text-[11px] font-mono text-slate-800 focus:outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100 focus:bg-white transition-all"
          />
        </div>

        <div>
          <span class="text-[11px] text-slate-500 mb-1.5 block">Xem trước ảnh:</span>
          <div class="aspect-video rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
            <img 
              id="cover-preview-img" 
              src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?w=1200&auto=format&fit=crop&q=80" 
              alt="Cover Preview" 
              class="w-full h-full object-cover"
            />
          </div>
        </div>

      </div>

    </div>

  </form>

  <script>
    import { slugify } from '../../../lib/utils';
    import { marked } from 'marked';

    const titleInput = document.getElementById('title') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    const contentInput = document.getElementById('content') as HTMLTextAreaElement;
    const previewContainer = document.getElementById('preview-container') as HTMLDivElement;
    const tabEdit = document.getElementById('tab-edit') as HTMLButtonElement;
    const tabPreview = document.getElementById('tab-preview') as HTMLButtonElement;
    const toolbarActions = document.getElementById('toolbar-actions') as HTMLDivElement;
    const coverInput = document.getElementById('cover_image') as HTMLInputElement;
    const coverPreviewImg = document.getElementById('cover-preview-img') as HTMLImageElement;
    const saveBtn = document.getElementById('save-post-btn') as HTMLButtonElement;
    const saveBtnText = document.getElementById('save-btn-text') as HTMLSpanElement;
    const REDIRECT_DELAY_MS = 600;
    const toast = (message: string, type: 'success' | 'error' | 'info' = 'info') => (window as any).showAdminToast?.(message, type);

    // Auto-slug generation
    titleInput?.addEventListener('input', () => {
      if (!slugInput.dataset.manual) {
        slugInput.value = slugify(titleInput.value);
      }
    });

    slugInput?.addEventListener('input', () => {
      slugInput.dataset.manual = 'true';
    });

    // Cover image preview
    coverInput?.addEventListener('input', () => {
      coverPreviewImg.src = coverInput.value;
    });

    // Editor tab toggle
    tabEdit?.addEventListener('click', () => {
      tabEdit.classList.add('bg-white', 'text-slate-900', 'shadow-2xs');
      tabEdit.classList.remove('text-slate-600');
      tabPreview.classList.remove('bg-white', 'text-slate-900', 'shadow-2xs');
      tabPreview.classList.add('text-slate-600');

      contentInput.classList.remove('hidden');
      previewContainer.classList.add('hidden');
      toolbarActions.classList.remove('hidden');
    });

    tabPreview?.addEventListener('click', async () => {
      tabPreview.classList.add('bg-white', 'text-slate-900', 'shadow-2xs');
      tabPreview.classList.remove('text-slate-600');
      tabEdit.classList.remove('bg-white', 'text-slate-900', 'shadow-2xs');
      tabEdit.classList.add('text-slate-600');

      const markdown = contentInput.value || '*Chưa có nội dung để hiển thị.*';
      previewContainer.innerHTML = (await marked.parse(markdown)) as string;
      contentInput.classList.add('hidden');
      previewContainer.classList.remove('hidden');
      toolbarActions.classList.add('hidden');
    });

    // Toolbar actions
    document.querySelectorAll('.tool-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const prefix = el.dataset.prefix;
        const syntax = el.dataset.syntax;
        const wrap = el.dataset.wrap;
        const wrapEnd = el.dataset.wrapEnd;

        const start = contentInput.selectionStart;
        const end = contentInput.selectionEnd;
        const selectedText = contentInput.value.substring(start, end);

        let replacement = '';
        if (prefix) {
          replacement = prefix + selectedText;
        } else if (wrap && wrapEnd) {
          replacement = wrap + (selectedText || 'code') + wrapEnd;
        } else if (syntax === 'link') {
          replacement = `[${selectedText || 'Tên liên kết'}](https://example.com)`;
        } else if (syntax === 'img') {
          window.dispatchEvent(new Event('media:open-content'));
          return;
        } else if (syntax) {
          replacement = syntax + (selectedText || 'nội dung') + syntax;
        }

        contentInput.setRangeText(replacement, start, end, 'select');
        contentInput.focus();
      });
    });

    // Save handler
    saveBtn?.addEventListener('click', async () => {
      const form = document.getElementById('post-form') as HTMLFormElement;
      if (!form.reportValidity()) {
        toast('Vui lòng kiểm tra các trường bắt buộc được đánh dấu *.', 'error');
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }

      saveBtn.disabled = true;
      saveBtnText.textContent = 'Đang lưu...';

      const formData = new FormData(form);
      const data = {
        title: formData.get('title'),
        slug: formData.get('slug'),
        excerpt: formData.get('excerpt'),
        content: formData.get('content'),
        cover_image: formData.get('cover_image'),
        category: formData.get('category'),
        tags: formData.get('tags'),
        status: formData.get('status'),
        author: formData.get('author'),
      };

      try {
        const res = await fetch('/api/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const resData = await res.json();
        if (res.ok && resData.success) {
          toast('Đã tạo bài viết thành công.', 'success');
          window.setTimeout(() => { window.location.href = '/admin/posts'; }, REDIRECT_DELAY_MS);
        } else {
          toast(resData.message || 'Lỗi khi tạo bài viết.', 'error');
          saveBtn.disabled = false;
          saveBtnText.textContent = 'Lưu bài viết';
        }
      } catch (err) {
        toast('Lỗi kết nối khi lưu bài viết.', 'error');
        saveBtn.disabled = false;
        saveBtnText.textContent = 'Lưu bài viết';
      }
    });
  </script>

</AdminLayout>