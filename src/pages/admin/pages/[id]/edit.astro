---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import PageEditor from '../../../../components/PageEditor.astro';
import { pageService } from '../../../../api';
const page = await pageService.getPageById(Number(Astro.params.id));
if (!page) return Astro.redirect('/admin/pages');
---

<AdminLayout title={`Sửa: ${page.title}`} activeNav="pages">
  <PageEditor page={page} />
</AdminLayout>
